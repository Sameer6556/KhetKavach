# Copy to .env (never commit .env). Only ANTHROPIC_API_KEY is needed for the AI agent;
# everything else has a working default.

# Claude API key (https://console.anthropic.com). Without it the app runs the rule-based advisor.
ANTHROPIC_API_KEY=

# Model and reasoning effort for the agent (effort: low | medium | high | xhigh | max).
KK_MODEL=claude-opus-5-5
KK_EFFORT=medium

# Free personal key from https://data.gov.in (My Account -> Generate API key). Without it the public
# sample key is used, which returns at most 10 mandi records per call.
DATA_GOV_IN_API_KEY=

# Optional: Telegram bot token from @BotFather to push Sentinel alerts to farmers' phones.
TELEGRAM_BOT_TOKEN=

# Sentinel sweep interval in minutes (0 disables the background monitor).
KK_SENTINEL_INTERVAL_MIN=180

# Satellite NDVI analysis (needs rasterio); set to 0 to disable.
KK_SATELLITE=1

# Where SQLite keeps the HTTP cache, farms and alerts.
KK_DB_PATH=./data/khetkavach.db

# Contact URL/email sent in the User-Agent (required by OpenStreetMap Nominatim's usage policy).
KK_CONTACT=https://github.com/Sameer6556/code-benders
