# Copy to .env (never commit .env). Set ONE AI key (Gemini or Claude) to enable the AI agent;
# without any key the app runs the rule-based advisor. Everything else has a working default.

# --- AI agent ------------------------------------------------------------------------------
# Option A: Google Gemini (free tier). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model; if it is not available to your key, the app falls back to gemini-flash-latest / gemini-2.5-flash.
KK_GEMINI_MODEL=gemini-flash-latest

# Option B: Anthropic Claude (paid per use). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Claude model and reasoning effort (effort: low | medium | high | xhigh | max).
KK_MODEL=claude-opus-5-5
KK_EFFORT=medium

# Which AI to use: auto (Claude if its key is set, else Gemini), gemini, claude, or rules (no AI).
KK_LLM_PROVIDER=auto

# --- Data ----------------------------------------------------------------------------------
# Free personal key from https://data.gov.in (My Account -> Generate API key). Without it the public
# sample key is used, which returns at most 10 mandi records per call.
DATA_GOV_IN_API_KEY=

# Optional: Telegram bot token from @BotFather to push Sentinel alerts to farmers' phones.
TELEGRAM_BOT_TOKEN=

# Sentinel sweep interval in minutes (0 disables the background monitor).
KK_SENTINEL_INTERVAL_MIN=180

# Satellite NDVI analysis (needs rasterio); set to 0 to disable.
KK_SATELLITE=1

# Where SQLite keeps the HTTP cache, farms and alerts.
KK_DB_PATH=./data/khetkavach.db

# Contact URL/email sent in the User-Agent (required by OpenStreetMap Nominatim's usage policy).
KK_CONTACT=https://github.com/Sameer6556/code-benders
